VITE_API_BASE_URL=/v1
VITE_AUTH_CSRF_COOKIE_NAME=kyrg_csrf_token

VITE_MAX_UPLOAD_BYTES=2147483648
VITE_ACCEPTED_MEDIA_TYPES=video/mp4,video/quicktime,video/webm,video/x-msvideo,audio/mpeg,audio/mp4,audio/ogg,audio/wav,audio/x-wav,audio/webm

# R2 credentials must never be placed in frontend environment variables.
# The browser receives only a short-lived upload_url from the authenticated API.
