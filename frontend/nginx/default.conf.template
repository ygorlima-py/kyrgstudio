server {
    listen 80;
    listen [::]:80;

    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;

    client_max_body_size ${NGINX_MAX_REQUEST_BODY_SIZE};

    # Mantém os headers globais mesmo quando uma location adiciona cache.
    add_header_inherit merge;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "base-uri 'self'; frame-ancestors 'none'; object-src 'none';" always;

    error_page 413 = @upload_too_large;

    location @upload_too_large {
        default_type application/json;
        return 413 '{"code":"upload_too_large","step":"validating_upload","details":{}}';
    }

    # Verification links contain a one-time token in the query string.
    # Keep this request out of Nginx access logs while preserving the API proxy.
    location = /v1/auth/verify-email {
        access_log off;

        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering off;

        add_header Cache-Control "no-store" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    location ^~ /v1/ {
        proxy_pass http://${API_UPSTREAM};

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_request_buffering off;

        add_header Cache-Control "no-store" always;

    }

    # O Vite adiciona hash aos nomes desses arquivos.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Arquivos públicos sem hash recebem cache curto.
    location ~* \.(?:ico|svg|png|jpg|jpeg|webp|avif|woff|woff2)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
    }

    # O HTML aponta para os assets atuais e nunca deve ficar preso em cache.
    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /robots.txt {
        default_type text/plain;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # A landing usa HTML pre-renderizado; as demais rotas hidratam a SPA vazia.
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /pt-BR {
        try_files /pt-BR/index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /en {
        try_files /en/index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location = /spa.html {
        internal;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    location / {
        try_files $uri $uri/ /spa.html;
    }
}
